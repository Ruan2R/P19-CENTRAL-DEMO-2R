# Desenvolvimento local
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# P15_LOCAL_DB_PATH=C:/caminho/para/local-db.json

# MySQL (opcional para teste em banco dedicado; requer schema aplicado manualmente)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=5

