# As duas contas administrativas e o segredo da sessão são criados com `npm run admin:setup`.
# O script guarda hashes scrypt dentro de ADMIN_USERS_JSON; nunca ponha senhas em texto puro.
# Nunca coloque ADMIN_USERS_JSON, hashes ou AUTH_SECRET em variáveis com prefixo VITE_.

# Público, inserido no build para apresentar o desafio antispam na interface.
VITE_TURNSTILE_SITE_KEY=

# Servidor Node.js — preenchido na etapa de deploy; não é exposto no frontend.
# Em produção, deixe a hospedagem fornecer PORT; localmente o padrão é 5173.
# HOST=0.0.0.0
# PORT=5173
# Em desenvolvimento, sem DB_HOST, o sistema usa data/local-db.json neste computador.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=5

# Em produção, configure estes valores nas variáveis de ambiente da hospedagem.
# VITE_TURNSTILE_SITE_KEY precisa estar definida no build e no runtime do app.
# NODE_ENV=production
# ADMIN_USERS_JSON=[{"id":"RUAN-2R","displayName":"Ruan Rodrigues","role":"owner","passwordHash":"scrypt$..."},{"id":"ANA-001","displayName":"Ana Amaral","role":"studio_admin","passwordHash":"scrypt$..."}]
# AUTH_SECRET=gerado-pelo-setup-com-pelo-menos-32-caracteres
# TURNSTILE_SECRET_KEY=chave-secreta-do-cloudflare-turnstile

# Dados públicos do Pix do estúdio. Configure apenas quando Ana fornecer os dados.
# Esses valores são exibidos à cliente; não use chaves administrativas/segredos aqui.
VITE_PIX_KEY=
VITE_PIX_HOLDER=
# Opcional: URL pública de uma imagem do QR Code Pix fornecido pelo estúdio.
VITE_PIX_QR_IMAGE_URL=
